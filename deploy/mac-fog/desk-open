#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
CLIENT=""
for cand in \
  "${HERE}/desk-open.py" \
  "${FOG_SRC:-}/deploy/mac-fog/desk-open.py" \
  "${HOME}/StrataMesh/fog/repo/deploy/mac-fog/desk-open.py"
do
  if [[ -n "${cand}" && -f "${cand}" ]]; then
    CLIENT="${cand}"
    break
  fi
done
if [[ -z "${CLIENT}" ]]; then
  echo "desk-open: desk-open.py not found" >&2
  exit 1
fi
exec python3 "${CLIENT}" "$@"
