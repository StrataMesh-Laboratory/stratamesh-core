[Unit]
Description=StrataMesh Fog Node (homelab peer)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/stratamesh-core/src
Environment=NODE_ID=FOG-NODE-HOME-001
Environment=PORT=8787
Environment=DB=/var/lib/stratamesh/fog.db
ExecStart=/usr/bin/python3 /opt/stratamesh-core/src/node_persistent.py --port 8787 --db /var/lib/stratamesh/fog.db --id FOG-NODE-HOME-001
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
