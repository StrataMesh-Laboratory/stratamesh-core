{
  "schema": "cmn.contingency.v1",
  "public_origin": "pages",
  "never": [
    "workers.dev",
    "fog-as-apex",
    "pkill-cloudflared"
  ],
  "layers": [
    {
      "id": "pages",
      "role": "public HTML",
      "hosts": [
        "calhegasmorais.pt",
        "sandbox.calhegasmorais.pt"
      ],
      "when": "always"
    },
    {
      "id": "python",
      "role": "auth/API fallback standard",
      "bind": "127.0.0.1:8790",
      "public": "mw.calhegasmorais.pt",
      "when": "worker 1027/405/429"
    },
    {
      "id": "node",
      "role": "auth/API peer",
      "bind": "127.0.0.1:8791",
      "public": "auth.calhegasmorais.pt",
      "when": "python miss"
    },
    {
      "id": "workerd",
      "role": "local worker runtime",
      "bind": "127.0.0.1:8788",
      "origin": "edge|fog",
      "when": "edge hop / fog hop \u2014 not apex"
    },
    {
      "id": "fog",
      "role": "reference node",
      "bind": "127.0.0.1:8787",
      "host": "mbpv",
      "when": "Mac live; never public origin"
    },
    {
      "id": "tailscale",
      "role": "ops mesh",
      "hosts": [
        "mbpv.taild31dc1.ts.net",
        "edge-grok-cmn-001.taild31dc1.ts.net"
      ],
      "when": "CF public hop dead; GHA TS_AUTHKEY"
    },
    {
      "id": "workers",
      "role": "CF /api only",
      "when": "under rails cap; not HTML"
    },
    {
      "id": "maintenance",
      "role": "static last page",
      "file": "frontend/maintenance-1xxx.html",
      "when": "all layers failed"
    }
  ],
  "auth_order": [
    "https://mw.calhegasmorais.pt/api/auth",
    "http://127.0.0.1:8790/api/auth",
    "https://auth.calhegasmorais.pt/api/auth",
    "http://127.0.0.1:8791/api/auth",
    "http://100.108.35.26:8790/api/auth"
  ],
  "last_layer": {
    "id": "maintenance",
    "file": "frontend/maintenance-1xxx.html",
    "routes": [
      "/manutencao",
      "/404",
      "/500"
    ],
    "when": "all hops failed"
  },
  "weight": {
    "pages": 0,
    "python": 1,
    "node": 1,
    "workerd": 2,
    "fog": 2,
    "tailscale": 1,
    "cf-worker": 10,
    "maintenance": 0,
    "rule": "serve cheapest ALLOW hop; STASIS sheds cf-worker to python then node then pages then maintenance",
    "deno": 1
  },
  "head": {
    "ref": "main",
    "via": [
      "live-from-git.yml",
      "loci-pages.yml",
      "outdated-aliases.yml",
      "hop-weight.yml"
    ]
  },
  "complements": [
    {
      "current": "cf-pages",
      "complement": "caddy-static",
      "also": [
        "github-pages",
        "codeberg-pages"
      ],
      "shed": "HTML bytes leave CF; Caddy on Fog/VPS serves frontend/ from HEAD",
      "weight": 0,
      "status": "lab-ready"
    },
    {
      "current": "cf-workers",
      "complement": "workerd-self",
      "also": [
        "python:8790",
        "node:8791"
      ],
      "shed": "isolates that blow the 100k cap run on workerd+Py+Node; CF only ALLOW slice",
      "weight": 2,
      "status": "live"
    },
    {
      "current": "cf-r2-kv-d1",
      "complement": "minio-or-garage",
      "also": [
        "postgres-local"
      ],
      "shed": "blobs/objects off R2; sessions off KV during STASIS",
      "weight": 1,
      "status": "lab-ready",
      "bind": "127.0.0.1:9000"
    },
    {
      "current": "fog-mac",
      "complement": "hetzner-or-fly-vm",
      "also": [
        "tailscale"
      ],
      "shed": "when mac_live=false >30min the VM is the same workerd+Caddy image from HEAD",
      "weight": 2,
      "status": "planned"
    },
    {
      "current": "atelier-sessions",
      "complement": "rivet-actors",
      "also": [],
      "shed": "long-lived workbench memory not a Worker isolate",
      "weight": 3,
      "status": "explore"
    },
    {
      "current": "faas-lab",
      "complement": "fn0-or-spin",
      "also": [],
      "shed": "Wasm experiments; not auth, not apex",
      "weight": 4,
      "status": "explore"
    },
    {
      "current": "cf-pages+workers",
      "complement": "deno-deploy",
      "also": [
        "github-pages"
      ],
      "shed": "additive 100k-class: split hosts/paths; do not double the same /api/auth",
      "weight": 5,
      "status": "planned"
    }
  ],
  "additive": [
    {
      "a": "cloudflare",
      "b": "deno-deploy",
      "mode": "strength-split",
      "note": "not a mirror. CF edge+HTML+WAF; Deno TS APIs; Python auth on cap."
    }
  ],
  "strength_split": {
    "cloudflare": {
      "keeps": [
        "apex DNS",
        "WAF",
        "Pages HTML",
        "Turnstile",
        "zone calhegasmorais.pt",
        "fail-open to origin"
      ],
      "why": "PoPs, TLS, custom hostnames already live"
    },
    "deno_deploy": {
      "takes": [
        "TypeScript APIs",
        "Node-shaped middleware",
        "status/mesh/read paths",
        "Hono/Fresh handlers from ops/bin/cmn-spa-node.mjs"
      ],
      "why": "native TS, longer CPU than CF free 10ms, npm/Deno 2 closer to :8791, deploys measured in seconds"
    },
    "python_fog": {
      "takes": [
        "auth fallback",
        "STASIS login"
      ],
      "why": "already standard anti-405"
    },
    "workerd_local": {
      "takes": [
        "same Worker source when CF ALLOW"
      ],
      "why": "compat, not extra SaaS cap"
    }
  },
  "cf_deno_fallback": {
    "ts_api": [
      "http://127.0.0.1:8792",
      "http://100.108.35.26:8792",
      "http://mbpv.taild31dc1.ts.net:8792",
      "${DENO_DEPLOY_URL}",
      "http://127.0.0.1:8791"
    ],
    "html": [
      "https://calhegasmorais.pt",
      "https://calhegasmorais-pt.pages.dev"
    ],
    "auth": [
      "https://mw.calhegasmorais.pt",
      "http://127.0.0.1:8790"
    ],
    "rule": "TS APIs prefer Deno; HTML stays Pages; auth stays Python. CF Workers only while ALLOW."
  },
  "mutual": {
    "rule": "Whoever is primary for a job, the other is secondary. STASIS demotes cf-worker off every job.",
    "jobs": {
      "html": {
        "primary": "cf-pages",
        "secondary": "deno-static",
        "stasis": "cf-pages"
      },
      "ts-api": {
        "primary": "deno",
        "secondary": "cf-worker",
        "stasis": "deno"
      },
      "edge-isolate": {
        "primary": "cf-worker",
        "secondary": "deno",
        "stasis": "deno"
      },
      "waf-dns-tls": {
        "primary": "cloudflare",
        "secondary": null,
        "stasis": "cloudflare"
      },
      "auth": {
        "primary": "python",
        "secondary": "node",
        "stasis": "python"
      }
    }
  }
}
