{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "desk.collegium.v1",
  "title": "Fog desk collegium",
  "definitions": {
    "metabol_pace": {
      "type": "string",
      "enum": [
        "ALLOW",
        "HOLD",
        "STASIS",
        "P0_BORROW"
      ]
    },
    "desk_task": {
      "type": "object",
      "required": [
        "schema",
        "id",
        "owner",
        "specialty",
        "intent",
        "status"
      ],
      "properties": {
        "schema": {
          "const": "desk.task.v1"
        },
        "id": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "specialty": {
          "type": "string",
          "enum": [
            "coord",
            "code",
            "claw",
            "fog",
            "edge",
            "lead",
            "mail"
          ]
        },
        "intent": {
          "type": "string"
        },
        "lanes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "propose",
            "constrain",
            "revise",
            "commit",
            "escalate",
            "done",
            "drop",
            "act",
            "audit",
            "amend",
            "vote",
            "refer",
            "dispute"
          ]
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "result": {
          "type": "string"
        },
        "sha": {
          "type": "string"
        },
        "ship_live": {
          "type": "boolean"
        },
        "source": {
          "type": "string"
        },
        "votes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "by": {
                "type": "string"
              },
              "vote": {
                "type": "string",
                "enum": [
                  "ack",
                  "nack"
                ]
              },
              "at": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "verb",
              "at"
            ],
            "properties": {
              "verb": {
                "type": "string"
              },
              "by": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "at": {
                "type": "string"
              },
              "vote": {
                "type": "string",
                "enum": [
                  "ack",
                  "nack"
                ]
              },
              "vote_phase": {
                "type": "string",
                "enum": [
                  "call",
                  "cast"
                ]
              },
              "sha": {
                "type": "string"
              },
              "result": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "ship_policy": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "desk.ship_policy.v1"
        },
        "majority_frac": {
          "type": "number"
        },
        "require_no_nack": {
          "type": "boolean"
        },
        "unanimous_authority": {
          "type": "boolean"
        }
      }
    }
  }
}
