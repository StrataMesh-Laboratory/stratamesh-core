  "ship_auto": {
    "enabled": true,
    "require_majority": true,
    "require_no_nack": true,
    "require_no_human_gate": true,
    "metric_bands": {
      "desk_score_min": 70,
      "protocol_ok": true,
      "claw_fog_public": 1,
      "tests_green_soft": true
    },
    "on_nack_or_oob": "escalate_to_stratagrok",
    "by": "hermes"
  },
  "bot_cap_contingency": {
    "when": "lane-bot HOLD|STASIS (grok-bot-included cap)",
    "continue": [
      "Mac TUI r/60s",
      "desk_ops cycle",
      "desk-agent-run hermes|opencode|openclaw",
      "Fog Assistant if lane-assistant ALLOW",
      "EDGE consume-only GETs"
    ],
    "bot_on_wake": "pull meters/outbox; escalate only failures/gates — never re-prompt routine"
  },
  "required_ids": [
    "stratagrok",
    "hermes",
    "opencode",
    "openclaw",
    "fog-assistant",
    "edge-assistant"
  ],
  "todo_board": {
    "path": "FOG/data/desk-outbox/TODO.md",
    "source": "desk_ops cycle / desk-agent-run → snapshot open_tasks + projected + escalated",
    "rule": "Agents pick only specialty-matching tasks from TODO.md; andre_human_gates escalate_to_andre; else stratagrok resolve_as_representative; diary cites task id"
  },
  "reports": {
    "dir": "FOG/data/desk-outbox/reports/",
    "gh": "gh-daily.md",
    "discourse": "discourse-daily.md",
    "latest": "latest.md",
    "sync": "ops/desk-collegium/desk_reports.py sync",
    "bot_cap_ok": true
  },
  "secrets_vault": {
    "doc": "ops/desk-collegium/SECRETS-VAULT.md",
    "roots": [
      "~/.config/stratagrok/",
      "~/.config/stratamesh/",
      "$FOG_HOME/data/secrets/"
    ],
    "access": "full_read_write_owned_tokens",
    "never": [
      "print_to_diary",
      "feed",
      "git",
      "chat",
      "pages",
      "discourse"
    ],
    "escalate_bot_only_if": [
      "vault_missing",
      "corrupt",
      "2fa"
    ],
    "files": [
      "automation.desk.imap",
      "automation.desk.smtp",
      "automation.desk.token",
