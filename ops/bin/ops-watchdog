#!/usr/bin/env python3
"""Lab watchdog: cheap /health probes, metabolic interval, P0/P1 scoring."""
from __future__ import annotations

import json
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
STATE = ROOT / "state"
LOGS = ROOT / "logs"
CFG = ROOT / "config" / "monitor.env"
LIB = ROOT / "lib"
sys.path.insert(0, str(LIB))
STATE.mkdir(exist_ok=True)
LOGS.mkdir(exist_ok=True)

from metabolism import (  # noqa: E402
    monitor_interval_sec,
    snapshot as metabolism_snapshot,
    record_spend,
    coalesce_intents,
    decide,
    load_rails,
    load_ledger,
    save_ledger,
    live_decide_kwargs,
)


def load_env():
    e = {}
    for line in CFG.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        e[k.strip()] = v.strip()
    return e


def get(url: str, timeout: float):
    req = urllib.request.Request(
        url,
        headers={"User-Agent": "ops-watchdog/1.1-metabolism", "Accept": "application/json,text/html,*/*"},
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            body = r.read(120000)
            data = None
            try:
                data = json.loads(body.decode("utf-8", "replace"))
            except Exception:
                data = None
            return {"ok": 200 <= r.status < 400, "http": r.status, "data": data}
    except urllib.error.HTTPError as ex:
        snippet = None
        try:
            raw = ex.read(2000)
            snippet = json.loads(raw.decode("utf-8", "replace"))
        except Exception:
            snippet = None
        return {"ok": False, "error": "HTTPError", "http": int(ex.code or 0), "data": snippet}
    except Exception as ex:
        return {"ok": False, "error": type(ex).__name__, "http": 0, "data": None}


def score(env, probes):
    reasons = []
    level = "OK"
    ac = probes.get("aiops") or {}
    st = probes.get("status") or {}
    apex = probes.get("apex") or {}
    edge = probes.get("edge") or {}
    gossip = probes.get("gossip") or {}
    fog = probes.get("fog") or {}

    sm = (ac.get("data") or {}).get("summary") or {}
    crit = int(sm.get("critical") or 0)
    warn = int(sm.get("warn") or 0)

    if env.get("P0_ON_CRITICAL", "1") == "1" and crit > 0:
        level = "P0"
        reasons.append(f"aiops_critical={crit}")
    if env.get("P0_ON_STATUS_DOWN", "1") == "1" and not st.get("ok") and not st.get("skipped"):
        level = "P0"
        reasons.append("status_unreachable")
    if env.get("P0_ON_APEX_DOWN", "1") == "1" and not apex.get("ok") and not apex.get("skipped"):
        level = "P0"
        reasons.append("apex_unreachable")

    if level != "P0":
        if env.get("P1_ON_WARN", "1") == "1" and warn > 0:
            level = "P1"
            reasons.append(f"aiops_warn={warn}")
        if env.get("P1_ON_EDGE_DOWN", "1") == "1" and not edge.get("ok") and not edge.get("skipped"):
            level = "P1"
            reasons.append("edge_down")
        peers = (gossip.get("data") or {}).get("count")
        if peers is None and isinstance(gossip.get("data"), dict):
            peers = len((gossip.get("data") or {}).get("peers") or [])
        if env.get("P1_ON_MESH_LT", "1") == "1" and peers is not None and peers < 1:
            level = "P1"
            reasons.append(f"mesh_peers={peers}")
        fog_http = fog.get("http") or 0
        if env.get("P1_ON_FOG_TUNNEL", "1") == "1" and not fog.get("skipped") and (
            fog_http in (530, 1033) or (not fog.get("ok") and fog_http != 0)
        ):
            if level != "P0":
                level = "P1"
            reasons.append(f"fog_tunnel_http={fog_http}")

    if level == "OK" and reasons == []:
        reasons.append("all_green")

    peers = (gossip.get("data") or {}).get("count")
    if peers is None and isinstance(gossip.get("data"), dict):
        peers = len((gossip.get("data") or {}).get("peers") or [])
    return level, reasons, {"critical": crit, "warn": warn, "peers": peers}


def _status_mod():
    """Load bin/metabolism-status (hyphenated) for live remaining/hour_spent sampling."""
    import importlib.util
    path = ROOT / "bin" / "metabolism-status"
    spec = importlib.util.spec_from_file_location("metabolism_status", path)
    if spec is None or spec.loader is None:
        return None
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def refresh_live(cfg: dict, now: datetime):
    """Sample live remaining + hour_spent. On failure return unknown (never remaining=100000)."""
    ledger = load_ledger()
    try:
        mod = _status_mod()
        if mod is None:
            return {}, ledger
        live = mod.sample_live(cfg, now)
        ledger = mod.merge_sampled(ledger, live)
        save_ledger(ledger)
        return live, ledger
    except Exception:
        return {}, ledger


def vendor_stasis(env) -> bool:
    """True only until the vendor refill instant. Lifts by itself at 00:00 UTC — nothing stays paused."""
    until = (env.get("STASIS_UNTIL") or "").strip()
    if not until:
        return False
    try:
        ts = datetime.fromisoformat(until.replace("Z", "+00:00"))
    except ValueError:
        return False
    return datetime.now(timezone.utc) < ts


def cycle(env):
    t0 = time.time()
    if vendor_stasis(env):
        # Apex is Pages (no Worker quota). Do not probe Worker hostnames until refill.
        timeout = min(float(env.get("HTTP_TIMEOUT_SEC", "6")), 6)
        apex = get(env.get("APEX_URL") or "https://calhegasmorais.pt/", timeout)
        rails = load_rails()
        live, ledger = refresh_live(rails, datetime.now(timezone.utc))
        meta = metabolism_snapshot(live=live, ledger=ledger)
        out = {
            "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "level": "HOLD",
            "reasons": ["controlled_burn_until_refill", "worker_http_deferred", "inc-1027"],
            "summary": {"critical": None, "warn": None, "peers": None, "apex_ok": apex.get("ok")},
            "probes": {"apex": {"ok": apex.get("ok"), "http": apex.get("http"), "error": apex.get("error")}},
            "call_grok": False,
            "urgency": 0,
            "elapsed_ms": int((time.time() - t0) * 1000),
            "agent": "grok@calhegasmorais.pt",
            "desk": "https://edge.calhegasmorais.pt/",
            "stasis": True,
            "stasis_until": env.get("STASIS_UNTIL"),
            "armed": True,
            "metabolism": {
                "schema": meta.get("schema"),
                "lisbon": meta.get("lisbon"),
                "night": meta.get("night"),
                "monitor_interval_sec": meta.get("monitor_interval_sec"),
                "grok": (meta.get("rails") or {}).get("grok-auto"),
                "no_sixth_cron": True,
                "hourly_cap_after_refill": 4167,
            },
        }
        (STATE / "last_watch.json").write_text(json.dumps(out, indent=2))
        (STATE / "metabolism.json").write_text(json.dumps(meta, indent=2))
        with (LOGS / "watch.jsonl").open("a") as f:
            f.write(json.dumps(out, separators=(",", ":")) + "\n")
        return out
    timeout = float(env.get("HTTP_TIMEOUT_SEC", "6"))
    aiops_url = env.get("AIOPS_HEALTH_URL") or env.get("AIOPS_ACTIONS_URL")
    if "/actions" in (aiops_url or ""):
        aiops_url = "https://aiops.calhegasmorais.pt/health"
    status_url = env.get("FOG_STATUS_URL") or ""
    if status_url.rstrip("/").endswith("status.calhegasmorais.pt"):
        status_url = status_url.rstrip("/") + "/health"
    rails = load_rails()
    now = datetime.now(timezone.utc)
    live, ledger = refresh_live(rails, now)
    cf_spec = (rails.get("rails") or {}).get("cf-worker-req") or {}
    cf_kw = live_decide_kwargs("cf-worker-req", cf_spec, live, ledger, now, rails)
    intents = [
        {"rail": "cf-pages", "url": env.get("APEX_URL") or "https://calhegasmorais.pt/", "pages": True, "signal": 1},
        {"rail": "cf-worker-req", "url": status_url, "signal": 1},
        {"rail": "cf-worker-req", "url": aiops_url, "signal": 1},
        {"rail": "cf-worker-req", "url": env.get("EDGE_HEALTH_URL"), "signal": 1},
        {"rail": "cf-worker-req", "url": env.get("GOSSIP_PEERS_URL"), "signal": 1},
    ]
    if env.get("FOG_TUNNEL_HEALTH_URL"):
        intents.append({"rail": "cf-worker-req", "url": env.get("FOG_TUNNEL_HEALTH_URL"), "signal": 1, "p1": True})
    if env.get("DEOMAIL_HEALTH_URL"):
        intents.append({"rail": "cf-worker-req", "url": env.get("DEOMAIL_HEALTH_URL"), "signal": 1})
    if env.get("API_EDGE_HEALTH_URL"):
        intents.append({"rail": "cf-worker-req", "url": env.get("API_EDGE_HEALTH_URL"), "signal": 1})
    plan = coalesce_intents(intents, rails)
    probes = {}
    worker_done = False
    last_verdict = None
    for step in plan:
        url = step.get("url") or ""
        if "workers.dev" in url:
            continue
        rail = step.get("rail") or "cf-worker-req"
        decide_kw = dict(cf_kw) if rail in ("cf-worker-req", "cf-pages") else {}
        v = decide(
            rail,
            remaining=decide_kw.get("remaining"),
            hour_spent=decide_kw.get("hour_spent"),
            reset_unix=decide_kw.get("reset_unix"),
            cost=float(step.get("cost") or 1),
            signal=float(step.get("signal") or 1),
            url=url,
            cfg=rails,
            ledger=ledger,
        )
        last_verdict = v
        if v.decision in ("HOLD", "STASIS") and not step.get("pages"):
            probes[step.get("name") or url] = {"ok": None, "http": 0, "error": v.reason, "skipped": True, "circuit": v.circuit}
            continue
        if step.get("coalesced") and worker_done:
            continue
        label = "apex" if step.get("pages") else ("status" if "status." in url or "127.0.0.1:8787" in url else url)
        if step.get("coalesced"):
            label = "status"
            worker_done = True
        probes[label] = get(url, timeout if not step.get("p1") else min(timeout, 4))
    if "apex" not in probes and env.get("APEX_URL"):
        probes["apex"] = get(env["APEX_URL"], timeout)
    level, reasons, summary = score(env, probes)
    record_spend("local-monitor", 1.0)
    meta = metabolism_snapshot(live=live, ledger=ledger)
    out = {
        "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "level": level,
        "reasons": reasons,
        "summary": summary,
        "probes": {k: {"ok": v.get("ok"), "http": v.get("http"), "error": v.get("error")} for k, v in probes.items()},
        "call_grok": level == "P0",
        "urgency": {"P0": 100, "P1": 60, "P2": 30, "OK": 0}[level],
        "elapsed_ms": int((time.time() - t0) * 1000),
        "agent": "grok@calhegasmorais.pt",
        "desk": "https://edge.calhegasmorais.pt/",
        "metabolism": {
            "schema": meta.get("schema"),
            "lisbon": meta.get("lisbon"),
            "night": meta.get("night"),
            "monitor_interval_sec": meta.get("monitor_interval_sec"),
            "grok": (meta.get("rails") or {}).get("grok-auto"),
            "cf_worker_req": (meta.get("rails") or {}).get("cf-worker-req"),
            "no_sixth_cron": True,
        },
    }
    if last_verdict is not None:
        d = last_verdict.as_dict()
        if cf_kw.get("hour_spent") is not None:
            d["hour_spent"] = cf_kw["hour_spent"]
        out["metabolism"]["last_decide"] = d
    (STATE / "last_watch.json").write_text(json.dumps(out, indent=2))
    (STATE / "metabolism.json").write_text(json.dumps(meta, indent=2))
    with (LOGS / "watch.jsonl").open("a") as f:
        f.write(json.dumps(out, separators=(",", ":")) + "\n")
    esc_path = STATE / "ESCALATION.json"
    if level == "P0":
        esc = {
            "schema": "stratamesh.escalation.v1",
            "level": "P0",
            "call_grok": True,
            "priority": "very_high",
            "at": out["at"],
            "reasons": reasons,
            "summary": summary,
            "action_for_automation": "Run immediate Night-style diagnostic + Dev Cycle; do not HOLD; fix P0 only. Metabolic: P0 may borrow, no retry-loop.",
            "notify": True,
        }
        esc_path.write_text(json.dumps(esc, indent=2))
        (STATE / "CALL_GROK").write_text(out["at"] + "\n" + "\n".join(reasons) + "\n")
    else:
        if esc_path.exists():
            esc_path.unlink()
        if (STATE / "CALL_GROK").exists():
            (STATE / "CALL_GROK").unlink()
        if level == "P1":
            (STATE / "ATTENTION.json").write_text(json.dumps(out, indent=2))
        elif (STATE / "ATTENTION.json").exists():
            (STATE / "ATTENTION.json").unlink()
    return out


def main():
    env = load_env()
    loop = "--loop" in sys.argv
    while True:
        out = cycle(env)
        interval = monitor_interval_sec() if env.get("METABOLISM", "1") == "1" else int(env.get("INTERVAL_SEC", "300"))
        if not loop:
            print(json.dumps(out, indent=2))
            return 0 if out["level"] != "P0" else 2
        time.sleep(max(60, interval))


if __name__ == "__main__":
    raise SystemExit(main())
