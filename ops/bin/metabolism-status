#!/usr/bin/env python3
"""Sample live remaining into the metabolism ledger and print a snapshot.

Never print secrets. Never GET workers.dev. Never GET https://calhegasmorais.pt/
(the refill one-shot owns that first GET). Never a 6th CF cron.
"""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))

from metabolism import (  # noqa: E402
    estimated_spent_slots,
    load_ledger,
    load_rails,
    save_ledger,
    snapshot,
)

HF_REFILL = datetime(2026, 9, 1, 0, 0, 0, tzinfo=timezone.utc)
CF_DAILY = 100_000
CF_ACCOUNT = "f3645fcb56675cf7250d8ba7358eb252"
SECRETS = Path("/home/box/.config/stratagrok/secrets.env")
GROK_USAGE_LIVE = Path("/tmp/metab/grok-usage-live.json")
# Hardcoded until the next grok.com Settings → Usage scrape.
# Reset text has no timezone; treated as Europe/Lisbon (session TZ).
GROK_ASSISTANT_SAMPLE = {
    "remaining_frac": 0.96,
    "remaining": 0.96,
    "used_pct": 4,
    "reset_unix": 1788184500,
    "reset_iso": "2026-08-31T14:55:00+01:00",
    "reset_tz_assumed": "Europe/Lisbon",
}



def _load_secret(name: str) -> str | None:
    if not SECRETS.exists():
        return None
    for line in SECRETS.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        if k.strip() == name:
            return v.strip().strip('"').strip("'")
    return None


def _cf_sum_requests(rows) -> int:
    if not rows:
        return 0
    return int((rows[0].get("sum") or {}).get("requests") or 0)


def _cf_worker_usage(now: datetime) -> dict | None:
    """Live Worker day used + current UTC hour used via GraphQL. Never workers.dev.

    Returns None on auth/transport/schema failure. Never invent remaining=100000.
    """
    import urllib.request
    token = _load_secret("CLOUDFLARE_API_TOKEN") or _load_secret("GOD_API")
    if not token:
        return None
    utc = now.astimezone(timezone.utc)
    day_start = utc.replace(hour=0, minute=0, second=0, microsecond=0)
    hour_start = utc.replace(minute=0, second=0, microsecond=0)
    payload = {
        "query": """
          query ($accountTag: String!, $dayFrom: Time!, $hourFrom: Time!, $to: Time!) {
            viewer {
              accounts(filter: { accountTag: $accountTag }) {
                day: workersInvocationsAdaptive(
                  limit: 1
                  filter: { datetime_geq: $dayFrom, datetime_lt: $to }
                ) { sum { requests } }
                hour: workersInvocationsAdaptive(
                  limit: 1
                  filter: { datetime_geq: $hourFrom, datetime_lt: $to }
                ) { sum { requests } }
              }
            }
          }
        """,
        "variables": {
            "accountTag": CF_ACCOUNT,
            "dayFrom": day_start.strftime("%Y-%m-%dT%H:%M:%SZ"),
            "hourFrom": hour_start.strftime("%Y-%m-%dT%H:%M:%SZ"),
            "to": utc.strftime("%Y-%m-%dT%H:%M:%SZ"),
        },
    }
    req = urllib.request.Request(
        "https://api.cloudflare.com/client/v4/graphql",
        data=json.dumps(payload).encode(),
        headers={"Authorization": "Bearer " + token, "Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            data = json.loads(r.read().decode())
    except Exception:
        return None
    try:
        if not data or not data.get("data"):
            return None
        acct = data["data"]["viewer"]["accounts"][0]
        return {
            "used": _cf_sum_requests(acct.get("day")),
            "hour_spent": _cf_sum_requests(acct.get("hour")),
        }
    except Exception:
        return None

def _gh_rate_limit() -> dict | None:
    """Call `gh api rate_limit`. Never print the token."""
    env = {k: v for k, v in os.environ.items() if k != "GITHUB_TOKEN" or True}
    # keep GITHUB_TOKEN in the child env so gh works; never echo it
    try:
        p = subprocess.run(
            ["gh", "api", "rate_limit"],
            capture_output=True,
            text=True,
            env=os.environ.copy(),
            timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if p.returncode != 0:
        return None
    try:
        return json.loads(p.stdout)
    except json.JSONDecodeError:
        return None


def _gh_meter(resource: dict) -> dict:
    """GitHub rate_limit resource → remaining + hour_spent + reset. Never print the token."""
    remaining = int(resource.get("remaining") or 0)
    entry: dict = {"remaining": remaining}
    if resource.get("reset"):
        entry["reset_unix"] = int(resource["reset"])
    if resource.get("used") is not None:
        entry["hour_spent"] = int(resource["used"])
    elif resource.get("limit") is not None:
        entry["hour_spent"] = max(0, int(resource["limit"]) - remaining)
    return entry


def sample_live(cfg: dict, now: datetime) -> dict:
    live: dict = {}
    rl = _gh_rate_limit()
    if rl:
        resources = rl.get("resources") or {}
        core = resources.get("core") or {}
        if "remaining" in core:
            live["github-core"] = _gh_meter(core)
        else:
            live["github-core"] = {"unknown": True}
        graphql = resources.get("graphql") or {}
        if "remaining" in graphql:
            live["github-graphql"] = _gh_meter(graphql)
        else:
            live["github-graphql"] = {"unknown": True}
        search = resources.get("search") or {}
        if "remaining" in search:
            live["github-search"] = _gh_meter(search)
        else:
            live["github-search"] = {"unknown": True}
    else:
        live["github-core"] = {"unknown": True}
        live["github-graphql"] = {"unknown": True}
        live["github-search"] = {"unknown": True}

    # CF: live remaining = 100k - GraphQL invocations since 00:00 UTC.
    # hour_spent = invocations in the current UTC hour. Pages Functions share this pool.
    # Static Pages do not. Never workers.dev. GraphQL failure → unknown (HOLD), never 100k.
    usage = _cf_worker_usage(now)
    if usage is None:
        live["cf-worker-req"] = {"unknown": True}
    else:
        used = int(usage.get("used") or 0)
        live["cf-worker-req"] = {
            "remaining": max(0, CF_DAILY - used),
            "used": used,
            "day_spent": used,
            "hour_spent": int(usage.get("hour_spent") or 0),
        }

    # HF remaining 0 until 2026-09-01
    live["hf-inference"] = {"remaining": 0}

    live["aws-free"] = {"remaining": 0}

    spent = estimated_spent_slots(cfg, now, "grok-auto")
    live["grok-auto"] = {"remaining": max(0.0, 6.0 - float(spent))}

    # SuperGrok weekly pool (percent remaining). grok-bot-included stays unknown.
    live["grok-assistant"] = _grok_assistant_sample()
    return live


def _grok_assistant_sample() -> dict:
    data = dict(GROK_ASSISTANT_SAMPLE)
    if GROK_USAGE_LIVE.exists():
        try:
            scraped = json.loads(GROK_USAGE_LIVE.read_text())
            for k in ("remaining_frac", "remaining", "used_pct", "reset_unix", "reset_iso", "reset_tz_assumed"):
                if k in scraped and scraped[k] is not None:
                    data[k] = scraped[k]
        except Exception:
            pass
    if data.get("remaining_frac") is not None and "remaining" not in data:
        data["remaining"] = data["remaining_frac"]
    return data


def merge_sampled(ledger: dict, live: dict) -> dict:
    rails = ledger.setdefault("rails", {})
    ledger.setdefault("schema", "stratamesh.metabolism.ledger.v1")
    for name, data in live.items():
        st = rails.setdefault(name, {})
        if data.get("unknown"):
            st["sampled_unknown"] = True
            st.pop("sampled_remaining", None)
            st.pop("sampled_hour_spent", None)
            continue
        st.pop("sampled_unknown", None)
        if "remaining" in data:
            st["sampled_remaining"] = data["remaining"]
        if "remaining_frac" in data:
            st["sampled_remaining_frac"] = data["remaining_frac"]
        if "used_pct" in data:
            st["sampled_used_pct"] = data["used_pct"]
        if "reset_unix" in data:
            st["sampled_reset_unix"] = data["reset_unix"]
        if "reset_iso" in data:
            st["sampled_reset_iso"] = data["reset_iso"]
        if "reset_tz_assumed" in data:
            st["sampled_reset_tz_assumed"] = data["reset_tz_assumed"]
        if data.get("hour_spent") is not None:
            st["sampled_hour_spent"] = data["hour_spent"]
        used = data.get("used")
        if used is None:
            used = data.get("day_spent")
        if used is not None:
            st["sampled_used"] = used
            st["day_spent"] = float(used)
    ledger["sampled_at"] = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    return ledger


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description="Metabolism snapshot / sampler")
    ap.add_argument("--sample", action="store_true", help="sample live remaining (gh rate_limit + calendar rails)")
    ap.add_argument("--pretty", action="store_true")
    args = ap.parse_args(argv)

    cfg = load_rails()
    now = datetime.now(timezone.utc)
    ledger = load_ledger()
    live: dict | None = None
    if args.sample:
        live = sample_live(cfg, now)
        ledger = merge_sampled(ledger, live)
        save_ledger(ledger)

    snap = snapshot(now=now, live=live, cfg=cfg, ledger=ledger)
    if args.pretty:
        print(json.dumps(snap, indent=2))
    else:
        print(json.dumps(snap, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
